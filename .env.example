# Gemini API Key (get from https://aistudio.google.com/app/apikey)
# This key is used for code analysis via the Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration - Backend (server-side)
# These are used by the FastAPI backend for database operations
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Configuration - Frontend (Vite)
# These are exposed to the client-side JavaScript
# They should match the backend Supabase credentials
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
